{
  "name": "attracker",
  "main": "app/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "triggers": { "crons": ["*/10 1-18 * * *"] },
  "observability": { "enabled": true }
}
